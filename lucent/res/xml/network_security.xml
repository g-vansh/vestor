<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only certificates from the system's own trust store: a certificate a user or
     another app added cannot be used to read or change Lucent's traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
