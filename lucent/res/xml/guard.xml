<?xml version="1.0" encoding="utf-8"?>
<!-- The least an accessibility service can ask for. It hears only that a window changed and
     which app and screen it belongs to (to spot Amazon's home), never what is on screen or what
     is typed, and it cannot press keys, read the remote, gesture or take screenshots. The
     window-change events of every app are needed, because the move away from Amazon's home is
     how it knows not to bring Lucent back over the app you just opened. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:canRequestFilterKeyEvents="false"
    android:canRequestTouchExplorationMode="false"
    android:canPerformGestures="false"
    android:canTakeScreenshot="false"
    android:notificationTimeout="0"
    android:description="@string/guard_description" />
